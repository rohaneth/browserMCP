# Browser Intelligence Agent - Environment Configuration Example
# Do not place real secrets in this file. Copy this to .env for local development.

# ==========================================
# PostgreSQL Database Configuration
# ==========================================
# The username for the PostgreSQL database
POSTGRES_USER=postgres
# The password for the PostgreSQL database (must be changed in production)
POSTGRES_PASSWORD=postgres_password
# The name of the default database to create/connect to
POSTGRES_DB=browser_agent_db
# The hostname where PostgreSQL is running (e.g., 'db' in docker-compose, or 'localhost' natively)
POSTGRES_HOST=localhost
# The port PostgreSQL listens on
POSTGRES_PORT=5432

# ==========================================
# FastAPI Backend Configuration
# ==========================================
# The host address for the FastAPI server to bind to
API_HOST=0.0.0.0
# The port the FastAPI server listens on
API_PORT=8000

# ==========================================
# Next.js Web Frontend Configuration
# ==========================================
# The port the Next.js frontend listens on
WEB_PORT=3000
# The public URL of the backend API for the frontend to communicate with
NEXT_PUBLIC_API_URL=http://localhost:8000
